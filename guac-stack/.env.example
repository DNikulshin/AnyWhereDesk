# =============================================================
# .env.example — скопируй в .env и заполни значения
# cp .env.example .env
#
# ВАЖНО: никогда не коммить .env в git
# =============================================================

# ── База данных ───────────────────────────────────────────
# PS : -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 16 | % {[char]$_})

# bash openssl rand -base64 24
DB_PASSWORD=ЗАМЕНИТЕ_НА_СЛОЖНЫЙ_ПАРОЛЬ

# ── Домен ────────────────────────────────────────────────
DOMAIN=your-domain.com

# ── Cloudflare DNS API (для SSL-сертификата) ─────────────
#
# Вариант 1 (рекомендуется): API Token
# Создать: cloudflare.com -> My Profile -> API Tokens -> Create Token
# Шаблон: "Edit zone DNS" -> Use template -> выбрать свой домен
#
CLOUDFLARE_API_TOKEN=

# Вариант 2: Global API Key (альтернатива — см. cloudflare-guide.md)
# Раскомментируй и заполни, если используешь Global API Key:
#
# CLOUDFLARE_EMAIL=your@email.com
# CLOUDFLARE_API_KEY=
