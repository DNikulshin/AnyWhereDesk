# Сборка Caddy с плагином Cloudflare DNS-challenge
# Используется в docker-compose.yml: build: { dockerfile: Dockerfile.caddy }

FROM caddy:2-builder-alpine AS builder

RUN xcaddy build \
    --with github.com/caddy-dns/cloudflare

FROM caddy:2-alpine

COPY --from=builder /usr/bin/caddy /usr/bin/caddy
